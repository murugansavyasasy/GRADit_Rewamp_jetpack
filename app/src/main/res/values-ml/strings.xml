    <!-- FAQs &amp; help -->
    <string name="faq_title">ചോദ്യങ്ങൾ &amp; സഹായം</string>
    <string name="faq_search_hint">ചോദ്യങ്ങൾ തിരയുക</string>
    <string name="faq_cat_all">എല്ലാം</string>
    <string name="faq_cat_account">അക്കൗണ്ട്</string>
    <string name="faq_cat_fees">ഫീസ്</string>
    <string name="faq_cat_attendance">ഹാജർ</string>
    <string name="faq_cat_more">കൂടുതൽ</string>
    <string name="faq_q1">എന്റെ പാസ്‌വേഡ് എങ്ങനെ റീസെറ്റ് ചെയ്യാം?</string>
    <string name="faq_a1">സൈൻ-ഇൻ സ്ക്രീനിൽ \"പാസ്‌വേഡ് മറന്നോ?\" ടാപ്പ് ചെയ്യുക, SMS അല്ലെങ്കിൽ ഇമെയിൽ തിരഞ്ഞെടുക്കുക, 6-അക്ക കോഡ് നൽകി പുതിയ പാസ്‌വേഡ് സജ്ജമാക്കുക.</string>
    <string name="faq_q2">ആപ്പിൽ ഒന്നിലധികം കുട്ടികളെ കാണാമോ?</string>
    <string name="faq_a2">അതെ. ലിങ്ക് ചെയ്ത വിദ്യാർത്ഥികൾ നിങ്ങളുടെ പ്രൊഫൈലിൽ കാണാം — അവർക്കിടയിൽ മാറാൻ ഒരു വിദ്യാർത്ഥിയെ ടാപ്പ് ചെയ്യുക.</string>
    <string name="faq_q3">എന്റെ ഫീസ് പേയ്‌മെന്റ് അടച്ചതായി കാണിക്കുന്നില്ല</string>
    <string name="faq_a3">അക്കൗണ്ട്സ് ഓഫീസ് നിങ്ങളുടെ തെളിവ് പരിശോധിച്ച ശേഷം പേയ്‌മെന്റ് അടച്ചതായി രേഖപ്പെടുത്തും. ഇതിന് 2 പ്രവൃത്തി ദിവസങ്ങൾ വരെ എടുത്തേക്കാം.</string>
    <string name="faq_q4">ഹാജർ തെറ്റായി രേഖപ്പെടുത്തി — ഞാൻ എന്ത് ചെയ്യണം?</string>
    <string name="faq_a4">ഹാജർ സ്ക്രീൻ തുറന്ന് പരാതി നൽകുക, അല്ലെങ്കിൽ ആപ്പ് വഴി നിങ്ങളുടെ ക്ലാസ് അധ്യാപകനെ ബന്ധപ്പെടുക.</string>
    <string name="faq_q5">വോയ്സ് സന്ദേശത്തിന് മറുപടി നൽകാമോ?</string>
    <string name="faq_a5">അതെ. സന്ദേശം തുറന്ന്, അധ്യാപകർക്ക് ടെക്സ്റ്റോ വോയ്സ് കുറിപ്പോ അയയ്ക്കാൻ മറുപടി ടാപ്പ് ചെയ്യുക.</string>
