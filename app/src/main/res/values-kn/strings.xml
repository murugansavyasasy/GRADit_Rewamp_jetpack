    <!-- FAQs &amp; help -->
    <string name="faq_title">ಪ್ರಶ್ನೆಗಳು &amp; ಸಹಾಯ</string>
    <string name="faq_search_hint">ಪ್ರಶ್ನೆಗಳನ್ನು ಹುಡುಕಿ</string>
    <string name="faq_cat_all">ಎಲ್ಲಾ</string>
    <string name="faq_cat_account">ಖಾತೆ</string>
    <string name="faq_cat_fees">ಶುಲ್ಕ</string>
    <string name="faq_cat_attendance">ಹಾಜರಾತಿ</string>
    <string name="faq_cat_more">ಇನ್ನಷ್ಟು</string>
    <string name="faq_q1">ನನ್ನ ಪಾಸ್‌ವರ್ಡ್ ಅನ್ನು ಹೇಗೆ ಮರುಹೊಂದಿಸುವುದು?</string>
    <string name="faq_a1">ಸೈನ್-ಇನ್ ಪರದೆಯಲ್ಲಿ \"ಪಾಸ್‌ವರ್ಡ್ ಮರೆತಿರಾ?\" ಟ್ಯಾಪ್ ಮಾಡಿ, SMS ಅಥವಾ ಇಮೇಲ್ ಆಯ್ಕೆಮಾಡಿ, 6-ಅಂಕಿ ಕೋಡ್ ನಮೂದಿಸಿ ಹೊಸ ಪಾಸ್‌ವರ್ಡ್ ಹೊಂದಿಸಿ.</string>
    <string name="faq_q2">ಆ್ಯಪ್‌ನಲ್ಲಿ ಒಂದಕ್ಕಿಂತ ಹೆಚ್ಚು ಮಕ್ಕಳನ್ನು ನೋಡಬಹುದೇ?</string>
    <string name="faq_a2">ಹೌದು. ಲಿಂಕ್ ಮಾಡಿದ ವಿದ್ಯಾರ್ಥಿಗಳು ನಿಮ್ಮ ಪ್ರೊಫೈಲ್‌ನಲ್ಲಿ ಕಾಣಿಸುತ್ತಾರೆ — ಅವರ ನಡುವೆ ಬದಲಾಯಿಸಲು ವಿದ್ಯಾರ್ಥಿಯನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ.</string>
    <string name="faq_q3">ನನ್ನ ಶುಲ್ಕ ಪಾವತಿ ಪಾವತಿಸಲಾಗಿದೆ ಎಂದು ತೋರಿಸುತ್ತಿಲ್ಲ</string>
    <string name="faq_a3">ಖಾತೆಗಳ ಕಚೇರಿ ನಿಮ್ಮ ಪುರಾವೆಯನ್ನು ಪರಿಶೀಲಿಸಿದ ನಂತರ ಪಾವತಿ ಪಾವತಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸಲಾಗುತ್ತದೆ. ಇದಕ್ಕೆ 2 ಕೆಲಸದ ದಿನಗಳವರೆಗೆ ತೆಗೆದುಕೊಳ್ಳಬಹುದು.</string>
    <string name="faq_q4">ಹಾಜರಾತಿ ತಪ್ಪಾಗಿ ಗುರುತಿಸಲಾಗಿದೆ — ನಾನು ಏನು ಮಾಡಬೇಕು?</string>
    <string name="faq_a4">ಹಾಜರಾತಿ ಪರದೆ ತೆರೆದು ದೂರು ಸಲ್ಲಿಸಿ, ಅಥವಾ ಆ್ಯಪ್ ಮೂಲಕ ನಿಮ್ಮ ತರಗತಿ ಶಿಕ್ಷಕರನ್ನು ಸಂಪರ್ಕಿಸಿ.</string>
    <string name="faq_q5">ಧ್ವನಿ ಸಂದೇಶಕ್ಕೆ ಉತ್ತರಿಸಬಹುದೇ?</string>
    <string name="faq_a5">ಹೌದು. ಸಂದೇಶ ತೆರೆದು, ಅಧ್ಯಾಪಕರಿಗೆ ಪಠ್ಯ ಅಥವಾ ಧ್ವನಿ ಟಿಪ್ಪಣಿ ಕಳುಹಿಸಲು ಉತ್ತರ ಟ್ಯಾಪ್ ಮಾಡಿ.</string>
    <string name="faq_q6">ಫಿಂಗರ್‌ಪ್ರಿಂಟ್ ಸೈನ್-ಇನ್ ಅನ್ನು ಹೇಗೆ ಆನ್ ಮಾಡುವುದು?</string>
