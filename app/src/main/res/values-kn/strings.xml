    <!-- Privacy policy -->
    <string name="privacy_title">ಗೌಪ್ಯತಾ ನೀತಿ</string>
    <string name="privacy_download_desc">ಡೌನ್‌ಲೋಡ್</string>
    <string name="privacy_summary_title">ನಿಮ್ಮ ಡೇಟಾ ನಿಮ್ಮ ಕಾಲೇಜ್‌ನಲ್ಲೇ ಇರುತ್ತದೆ</string>
    <string name="privacy_summary_body">University College of Engineering, Chennai ಆ್ಯಪ್ ಮೂಲಕ ಏನನ್ನು, ಏಕೆ ಸಂಗ್ರಹಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ಈ ಸಾರಾಂಶ ವಿವರಿಸುತ್ತದೆ. ಪೂರ್ಣ ನೀತಿಯನ್ನು ಕೆಳಗೆ ಓದಿ.</string>
    <string name="privacy_meta">ಕೊನೆಯ ನವೀಕರಣ [DATE] · ಆವೃತ್ತಿ [X.X]</string>
    <string name="privacy_s1_title">ನಾವು ಸಂಗ್ರಹಿಸುವ ಮಾಹಿತಿ</string>
    <string name="privacy_s1_body">ನಿಮ್ಮ ಹೆಸರು, ಸಂಪರ್ಕ ವಿವರಗಳು, ಹಾಜರಾತಿ, ಅಂಕಗಳು, ಶುಲ್ಕ ದಾಖಲೆಗಳು ಮತ್ತು ಆ್ಯಪ್ ಮೂಲಕ ಕಳುಹಿಸುವ ಸಂದೇಶಗಳು. [REVIEW WITH LEGAL]</string>
    <string name="privacy_s2_title">ನಾವು ಅದನ್ನು ಹೇಗೆ ಬಳಸುತ್ತೇವೆ</string>
    <string name="privacy_s2_body">ಶೈಕ್ಷಣಿಕ ಪ್ರಗತಿ ತೋರಿಸಲು, ಸೂಚನೆಗಳು ಮತ್ತು ಜ್ಞಾಪನೆಗಳನ್ನು ಕಳುಹಿಸಲು, ಶುಲ್ಕ ಪಾವತಿ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಲು, ಕುಟುಂಬಗಳು ಅಧ್ಯಾಪಕರನ್ನು ತಲುಪಲು ಸಹಾಯ ಮಾಡಲು. [REVIEW WITH LEGAL]</string>
    <string name="privacy_s3_title">ನಿಮ್ಮ ಡೇಟಾ ಯಾರು ನೋಡಬಹುದು</string>
    <string name="privacy_s3_body">ನಿಮ್ಮ ಕಾಲೇಜ್ ಸಿಬ್ಬಂದಿ, ಮತ್ತು ವಿದ್ಯಾರ್ಥಿಯೊಂದಿಗೆ ಲಿಂಕ್ ಆದ ಪೋಷಕರು ಅಥವಾ ಪಾಲಕರು. ನಾವು ನಿಮ್ಮ ಡೇಟಾವನ್ನು ಮಾರುವುದಿಲ್ಲ. [REVIEW WITH LEGAL]</string>
    <string name="privacy_s4_title">ಸಂಗ್ರಹಣೆ &amp; ಭದ್ರತೆ</string>
    <string name="privacy_s4_body">ಡೇಟಾವನ್ನು ಸುರಕ್ಷಿತವಾಗಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ, ಪ್ರವೇಶವು ಅಧಿಕೃತ ಕಾಲೇಜ್ ಸಿಬ್ಬಂದಿಗೆ ಮಾತ್ರ ಸೀಮಿತ. [REVIEW WITH LEGAL]</string>
    <string name="privacy_s5_title">ನಿಮ್ಮ ಆಯ್ಕೆಗಳು &amp; ಹಕ್ಕುಗಳು</string>
    <string name="privacy_s5_body">ನಿಮ್ಮ ಡೇಟಾದ ಪ್ರತಿಯನ್ನು ವಿನಂತಿಸಬಹುದು ಅಥವಾ ಅದನ್ನು ಸರಿಪಡಿಸಲು ಕಾಲೇಜ್‌ಗೆ ಕೇಳಬಹುದು. [REVIEW WITH LEGAL]</string>
    <string name="privacy_s6_title">ಈ ನೀತಿಯಲ್ಲಿ ಬದಲಾವಣೆಗಳು</string>
    <string name="privacy_s6_body">ನಾವು ಈ ನೀತಿಯನ್ನು ನವೀಕರಿಸಬಹುದು, ಮೇಲೆ ದಿನಾಂಕ ಮತ್ತು ಆವೃತ್ತಿಯನ್ನು ನಮೂದಿಸುತ್ತೇವೆ. [REVIEW WITH LEGAL]</string>
    <string name="privacy_contact">ಪ್ರಶ್ನೆಗಳೇ? ನಮ್ಮ ಡೇಟಾ ಅಧಿಕಾರಿಗೆ [PRIVACY EMAIL] ಗೆ ಬರೆಯಿರಿ</string>
    <string name="privacy_read_terms">ನಿಯಮಗಳು &amp; ಷರತ್ತುಗಳನ್ನು ಓದಿ</string>

    <!-- Terms &amp; conditions -->
    <string name="terms_title">ನಿಯಮಗಳು &amp; ಷರತ್ತುಗಳು</string>
    <string name="terms_effective">ಜಾರಿ [DATE]</string>
    <string name="terms_read_time">ಸುಮಾರು 4 ನಿಮಿಷ ಓದುವಿಕೆ</string>
    <string name="terms_s1_title">ಆ್ಯಪ್ ಬಳಸುವುದು</string>
    <string name="terms_s1_body">ಈ ಆ್ಯಪ್ University College of Engineering, Chennai ನ ವಿದ್ಯಾರ್ಥಿಗಳು, ಪೋಷಕರು ಮತ್ತು ಸಿಬ್ಬಂದಿಗಾಗಿ. ಸೈನ್ ಇನ್ ಮಾಡುವ ಮೂಲಕ ನೀವು ಈ ನಿಯಮಗಳನ್ನು ಒಪ್ಪುತ್ತೀರಿ.</string>
    <string name="terms_s2_title">ನಿಮ್ಮ ಖಾತೆ</string>
    <string name="terms_s2_body">ನಿಮ್ಮ ಪಾಸ್‌ವರ್ಡ್ ಮತ್ತು OTP ಗಳನ್ನು ಗೌಪ್ಯವಾಗಿಡಿ. ನಿಮ್ಮ ಖಾತೆಯ ಚಟುವಟಿಕೆಗೆ ನೀವೇ ಜವಾಬ್ದಾರರು, ದುರ್ಬಳಕೆಯನ್ನು ಕಾಲೇಜ್ ಕಚೇರಿಗೆ ವರದಿ ಮಾಡಿ.</string>
    <string name="terms_s3_title">ಗೌರವಯುತ ಸಂವಹನ</string>
    <string name="terms_s3_body">ಸಂದೇಶಗಳು, ಧ್ವನಿ ಟಿಪ್ಪಣಿಗಳು ಮತ್ತು ದೂರುಗಳು ಗೌರವಯುತ ಹಾಗೂ ಕಾಲೇಜ್‌ಗೆ ಸಂಬಂಧಿಸಿರಬೇಕು. ಅವಹೇಳನಕಾರಿ ವಿಷಯವನ್ನು ತೆಗೆದುಹಾಕಬಹುದು.</string>
    <string name="terms_s4_title">ಶುಲ್ಕ &amp; ಪಾವತಿಗಳು</string>
    <string name="terms_s4_body">ಶುಲ್ಕ ಮೊತ್ತ ಮತ್ತು ಬಾಕಿ ದಿನಾಂಕಗಳನ್ನು ಕಾಲೇಜ್ ನಿಗದಿಪಡಿಸುತ್ತದೆ. ಪಾವತಿ ಪುರಾವೆಗಳನ್ನು ಪಾವತಿಸಲಾಗಿದೆ ಎಂದು ಗುರುತಿಸುವ ಮೊದಲು ಖಾತೆಗಳ ಕಚೇರಿ ಪರಿಶೀಲಿಸುತ್ತದೆ. [REVIEW WITH LEGAL]</string>
    <string name="terms_s5_title">ಮಾಹಿತಿಯ ನಿಖರತೆ</string>
    <string name="terms_s5_body">ಹಾಜರಾತಿ, ಅಂಕಗಳು ಮತ್ತು ಸೂಚನೆಗಳನ್ನು ಕಾಲೇಜ್ ಪ್ರಕಟಿಸುತ್ತದೆ. ಏನಾದರೂ ತಪ್ಪಾಗಿದ್ದರೆ ಆ್ಯಪ್‌ನಲ್ಲಿ ದೂರು ಸಲ್ಲಿಸಿ.</string>
    <string name="terms_s6_title">ಬದಲಾವಣೆಗಳು &amp; ಸಂಪರ್ಕ</string>
    <string name="terms_s6_body">ನಾವು ಈ ನಿಯಮಗಳನ್ನು ನವೀಕರಿಸಬಹುದು, ಆ್ಯಪ್‌ನಲ್ಲಿ ನಿಮಗೆ ತಿಳಿಸುತ್ತೇವೆ. ಪ್ರಶ್ನೆಗಳಿಗೆ ಕಾಲೇಜ್ ಕಚೇರಿಯನ್ನು ಸಂಪರ್ಕಿಸಿ. [REVIEW WITH LEGAL]</string>
    <string name="terms_agree_prefix">ನಾನು ಓದಿದ್ದೇನೆ ಮತ್ತು ಒಪ್ಪುತ್ತೇನೆ </string>
    <string name="terms_agree_terms">ನಿಯಮಗಳು &amp; ಷರತ್ತುಗಳು</string>
    <string name="terms_agree_middle"> ಮತ್ತು </string>
    <string name="terms_agree_privacy">ಗೌಪ್ಯತಾ ನೀತಿ</string>
