    <!-- Privacy policy -->
    <string name="privacy_title">தனியுரிமைக் கொள்கை</string>
    <string name="privacy_download_desc">பதிவிறக்கு</string>
    <string name="privacy_summary_title">உங்கள் தரவு உங்கள் கல்லூரியிடமே இருக்கும்</string>
    <string name="privacy_summary_body">University College of Engineering, Chennai செயலி மூலம் எதை, ஏன் சேகரிக்கிறது என்பதை இந்தச் சுருக்கம் விளக்குகிறது. முழுக் கொள்கையை கீழே படியுங்கள்.</string>
    <string name="privacy_meta">கடைசி புதுப்பிப்பு [DATE] · பதிப்பு [X.X]</string>
    <string name="privacy_s1_title">நாங்கள் சேகரிக்கும் தகவல்</string>
    <string name="privacy_s1_body">உங்கள் பெயர், தொடர்பு விவரங்கள், வருகை, மதிப்பெண்கள், கட்டணப் பதிவுகள் மற்றும் செயலி வழியாக அனுப்பும் செய்திகள். [REVIEW WITH LEGAL]</string>
    <string name="privacy_s2_title">நாங்கள் அதை எப்படிப் பயன்படுத்துகிறோம்</string>
    <string name="privacy_s2_body">கல்வி முன்னேற்றத்தைக் காட்ட, அறிவிப்புகளும் நினைவூட்டல்களும் அனுப்ப, கட்டணம் செயலாக்க, குடும்பங்கள் ஆசிரியர்களைத் தொடர்பு கொள்ள உதவ. [REVIEW WITH LEGAL]</string>
    <string name="privacy_s3_title">உங்கள் தரவை யார் பார்க்க முடியும்</string>
    <string name="privacy_s3_body">உங்கள் கல்லூரி பணியாளர்கள், மற்றும் மாணவருடன் இணைந்த பெற்றோர் அல்லது பாதுகாவலர்கள். உங்கள் தரவை நாங்கள் விற்பதில்லை. [REVIEW WITH LEGAL]</string>
    <string name="privacy_s4_title">சேமிப்பு &amp; பாதுகாப்பு</string>
    <string name="privacy_s4_body">தரவு பாதுகாப்பாகச் சேமிக்கப்படுகிறது, அங்கீகரிக்கப்பட்ட கல்லூரி பணியாளர்களுக்கே அணுகல் வரம்பு. [REVIEW WITH LEGAL]</string>
    <string name="privacy_s5_title">உங்கள் தேர்வுகள் &amp; உரிமைகள்</string>
    <string name="privacy_s5_body">உங்கள் தரவின் நகலைக் கோரலாம் அல்லது அதைச் சரிசெய்யக் கல்லூரியைக் கேட்கலாம். [REVIEW WITH LEGAL]</string>
    <string name="privacy_s6_title">இந்தக் கொள்கையில் மாற்றங்கள்</string>
    <string name="privacy_s6_body">இந்தக் கொள்கையைப் புதுப்பிக்கலாம், மேலே தேதியையும் பதிப்பையும் குறிப்போம். [REVIEW WITH LEGAL]</string>
    <string name="privacy_contact">கேள்விகளா? எங்கள் தரவு அதிகாரிக்கு [PRIVACY EMAIL] இல் எழுதுங்கள்</string>
    <string name="privacy_read_terms">விதிமுறைகள் &amp; நிபந்தனைகளைப் படி</string>

    <!-- Terms &amp; conditions -->
    <string name="terms_title">விதிமுறைகள் &amp; நிபந்தனைகள்</string>
    <string name="terms_effective">அமலுக்கு வரும் [DATE]</string>
    <string name="terms_read_time">சுமார் 4 நிமிட வாசிப்பு</string>
    <string name="terms_s1_title">செயலியைப் பயன்படுத்துதல்</string>
    <string name="terms_s1_body">இந்தச் செயலி University College of Engineering, Chennai இன் மாணவர்கள், பெற்றோர் மற்றும் பணியாளர்களுக்கானது. உள்நுழைவதன் மூலம் இந்த விதிமுறைகளை ஏற்கிறீர்கள்.</string>
    <string name="terms_s2_title">உங்கள் கணக்கு</string>
    <string name="terms_s2_body">உங்கள் கடவுச்சொல்லையும் OTP-யையும் தனிப்பட்டதாக வைக்கவும். உங்கள் கணக்கின் செயல்பாட்டுக்கு நீங்களே பொறுப்பு, தவறான பயன்பாட்டைக் கல்லூரி அலுவலகத்துக்குத் தெரிவிக்கவும்.</string>
    <string name="terms_s3_title">மரியாதையான தொடர்பு</string>
    <string name="terms_s3_body">செய்திகள், குரல் குறிப்புகள் மற்றும் புகார்கள் மரியாதையாகவும் கல்லூரி தொடர்பானதாகவும் இருக்க வேண்டும். தவறான உள்ளடக்கம் நீக்கப்படலாம்.</string>
    <string name="terms_s4_title">கட்டணம் &amp; செலுத்துதல்</string>
    <string name="terms_s4_body">கட்டணத் தொகையும் நிலுவைத் தேதிகளும் கல்லூரியால் நிர்ணயிக்கப்படும். கட்டணச் சான்றுகள் கட்டணம் செலுத்தப்பட்டதாகக் குறிக்கப்படுவதற்கு முன் கணக்கு அலுவலகத்தால் சரிபார்க்கப்படும். [REVIEW WITH LEGAL]</string>
    <string name="terms_s5_title">தகவலின் துல்லியம்</string>
    <string name="terms_s5_body">வருகை, மதிப்பெண்கள் மற்றும் அறிவிப்புகள் கல்லூரியால் வெளியிடப்படும். ஏதேனும் தவறாகத் தோன்றினால் செயலியில் புகார் செய்யவும்.</string>
    <string name="terms_s6_title">மாற்றங்கள் &amp; தொடர்பு</string>
    <string name="terms_s6_body">இந்த விதிமுறைகளைப் புதுப்பிக்கலாம், செயலியில் உங்களுக்கு அறிவிப்போம். கேள்விகளுக்குக் கல்லூரி அலுவலகத்தைத் தொடர்பு கொள்ளவும். [REVIEW WITH LEGAL]</string>
    <string name="terms_agree_prefix">நான் படித்து ஒப்புக்கொள்கிறேன் </string>
    <string name="terms_agree_terms">விதிமுறைகள் &amp; நிபந்தனைகள்</string>
